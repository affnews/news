---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
<nav>
	<a href="/" class="logo">
		<img src="/logo.png" alt="AffNews" />
	</a>

	<div class="internal-links">
		<HeaderLink href="/tools">Tools</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
	</div>
</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
	display: flex;
	align-items: center;
	justify-content: space-between;
	max-width: 1200px;
	margin: 0 auto;
	padding: 0.75rem 1rem;
}

.logo {
	flex-shrink: 0;
	min-width: 180px;
}

.logo img {
	height: 55px;
	min-width: 180px;
	display: block;
	min-height: 55px;
}

.internal-links {
	display: flex;
	gap: 1.5rem;
	align-items: center;
}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
